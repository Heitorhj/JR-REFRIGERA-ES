# Servidor
PORT=3333
NODE_ENV=development

# Banco de dados (SQLite)
DB_PATH=./data/jr-refrigeracoes.db

# Autenticação (troque o segredo em produção: mínimo 32 caracteres)
JWT_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio
JWT_EXPIRES_IN=8h

# Administrador inicial (criado pelo `npm run seed`)
ADMIN_EMAIL=junior@jrrefrigeracoes.com
ADMIN_PASSWORD=TroqueEstaSenha@123

# CORS (URL do front-end React)
CORS_ORIGIN=http://localhost:5173

# Dias de retenção de pedidos CANCELADO/RECUSADO antes do expurgo
RETENCAO_DIAS=7

# Rate limiting
RATE_LIMIT_GERAL_MAX=100
RATE_LIMIT_LOGIN_MAX=5
